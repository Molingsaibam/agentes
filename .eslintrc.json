{
  "env": {
    "node": true,
    "es2022": true
  },
  "ignorePatterns": ["node_modules/", "cleanup/"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "warn",
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": ["frontend/**/*.js", "cleanup/**/*.js"],
      "env": {
        "browser": true,
        "node": false
      }
    }
  ]
}
